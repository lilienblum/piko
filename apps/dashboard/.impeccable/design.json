  "narrative": {
    "northStar": "The Field-Station Workbench",
    "overview": "Piko is a small measurement workbench: calm, readable, and precise enough for daily investigation. Cool stone working surfaces, pine action and data marks, and a pale citron navigation rail establish an observational character. Public Sans and the existing three-stroke Piko mark keep the identity clear without ornamental botanical imagery.\n\nAnalytical regions share a continuous ground with fine seams, aligned labels, and tabular values. Editing and inspection use contained surfaces where boundaries clarify the task. Density serves reading: supporting context remains visible, and loading states preserve the geometry of the result they will replace. Light, Dark, and Auto belong to the same visual world.",
    "keyCharacteristics": [
      "Stone ground, pine emphasis, citron orientation.",
      "Humanist typography with restrained headings and prominent measurements.",
      "Flat analytical fields; contained forms and inspection.",
      "Compact controls, explicit focus, and stable loading geometry."
    ],
    "rules": [
      {
        "name": "The Measured Color Rule",
        "body": "Use primary color for actions, focus, status, and the plotted measurement; use neutral surfaces and muted text for the surrounding evidence.",
        "section": "colors"
      },
      {
        "name": "The Value Alignment Rule",
        "body": "Use tabular numerals for measurements, percentages, durations, and times that readers compare across rows.",
        "section": "typography"
      },
      {
        "name": "The Shared Ground Rule",
        "body": "Keep analytical regions flat and aligned; reserve enclosed containers for editing, inspection, and genuinely separate context.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse semantic theme variables so Light, Dark, and Auto retain the same hierarchy.",
      "Do preserve the three-stroke mark, Public Sans, and pine/citron relationship.",
      "Do align measurements and use fine dividers to connect analytical regions.",
      "Do keep visible labels, focus outlines, readable metadata, and touch-sized controls on narrow screens.",
      "Do preserve chart and table geometry while data loads or refreshes.",
      "Do use the existing line chart, actual event identity kinds, and truthful empty or error states."
    ],
    "donts": [
      "Don't return to a corporate blue card grid or a black neon terminal identity.",
      "Don't wrap every measurement in a raised, rounded card.",
      "Don't add decorative botanical imagery, faux paper textures, or ornamental glow.",
      "Don't replace useful event context with decoration or hide an actual loading failure behind a skeleton.",
      "Don't turn the Explore composition into a mandatory layout for every page."
    ]
  }
}
