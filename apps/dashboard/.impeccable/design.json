  "narrative": {
    "northStar": "Kanagawa Wave",
    "overview": "Piko is a compact measurement tool using the user-selected Kanagawa palette. Sumi-ink surfaces and warm Fuji text frame Surimi Orange actions, Carp Yellow measurements, violet/aqua source categories, and green outcomes. Self-hosted Geist, softly squared controls, inset fields, single-frame segmented choices, and the upright three-bar mark give the interface its precise, quiet character. Accessible shadcn Base UI primitives and Hugeicons provide the shared component language.\n\nAnalytical regions use flat surfaces, fine seams, aligned labels, and tabular values. Overview groups related evidence into six square widgets; Explore retains its open analytical field. Editing and inspection use contained surfaces where boundaries clarify the task. Density serves reading: supporting context remains visible, and loading states preserve the geometry of the result they will replace. One palette is present in server-rendered HTML and CSS. There is no appearance selector, theme preference, or system-theme listener.",
    "keyCharacteristics": [
      "Sumi-ink surfaces, warm text, orange actions, and yellow/violet/aqua data accents.",
      "Geist typography with restrained headings and prominent measurements.",
      "Flat analytical fields and square Overview widgets; contained forms and inspection.",
      "Softly squared controls, inset fields, warm selection, one focus outline, and stable geometry."
    ],
    "rules": [
      {
        "name": "The Measured Color Rule",
        "body": "Orange marks actions and destination selection; yellow, violet, and aqua distinguish measurements; green and red label outcomes. Selected choices and keyboard focus use warm yellow within the same palette.",
        "section": "colors"
      },
      {
        "name": "The Value Alignment Rule",
        "body": "Use tabular numerals for measurements, percentages, durations, and times that readers compare across rows.",
        "section": "typography"
      },
      {
        "name": "The Shared Ground Rule",
        "body": "Keep analytical regions flat and aligned. Fine boundaries group related measurements; reserve soft elevation for filled actions and temporary overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse semantic theme variables to preserve one consistent palette from the first server paint.",
      "Do preserve the shared upright three-bar logo/favicon, Geist, and the Kanagawa sumi-ink/orange/yellow relationship.",
      "Do align measurements and use fine dividers to connect analytical regions.",
      "Do use inset fields, single-frame segmented choices, and semantic hover/pressed/selection states.",
      "Do keep visible labels, one ring-colored focus outline, readable metadata, and touch-sized controls on narrow screens.",
      "Do preserve chart and table geometry while data loads or refreshes.",
      "Do use TanStack line and donut charts, actual event identity kinds, and truthful empty or error states.",
      "Do keep Overview widgets square and flat while preserving their exact measures, local loading, and responsive reading order."
    ],
    "donts": [
      "Don't return to a corporate blue card grid or a black neon terminal identity.",
      "Don't wrap every measurement in a raised, rounded card.",
      "Don't reintroduce beveled button faces, split-arrow compartments, individual segment frames, or filled orange destination navigation.",
      "Don't add decorative botanical imagery, faux paper textures, or ornamental glow.",
      "Don't replace useful event context with decoration or hide an actual loading failure behind a skeleton.",
      "Don't turn either the Explore composition or the Overview widget grid into a mandatory layout for every page."
    ]
  }
}
