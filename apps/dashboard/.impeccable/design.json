      "css": ".ds-badge{display:inline-flex;align-items:center;padding:2px 8px;border:1px solid var(--border);border-radius:9999px;color:var(--foreground);background:transparent;font:500 12px/1.5 \"Public Sans Variable\",sans-serif;white-space:nowrap;}"
    },
    {
      "name": "Contained card",
      "kind": "card",
      "refersTo": "card-contained",
      "description": "A bounded editing region; no resting shadow.",
      "html": "<section class=\"ds-card\"><h2 class=\"ds-card-title\">Product details</h2><p class=\"ds-card-description\">Give this product a name and set its defaults.</p><div class=\"ds-card-content\">Product settings</div></section>",
      "css": ".ds-card{padding:20px 24px;border:1px solid var(--border);border-radius:16px;background:var(--card);color:var(--foreground);box-shadow:none;font-family:\"Public Sans Variable\",sans-serif;font-size:14px;}.ds-card-title{margin:0;font-size:15px;font-weight:650;line-height:1.5;letter-spacing:-.01em;}.ds-card-description{margin:3px 0 0;color:var(--muted-foreground);font-size:12px;line-height:1.6;}.ds-card-content{margin-top:16px;}"
    },
    {
      "name": "Measurement field",
      "kind": "custom",
      "refersTo": "measurement-field",
      "description": "Open analytical section bounded by fine horizontal seams.",
      "html": "<section class=\"ds-measurement\"><h2 class=\"ds-measurement-title\">Events over time</h2><p class=\"ds-measurement-description\">Events in the selected range.</p><span class=\"ds-measurement-label\">Events</span><strong class=\"ds-measurement-value\">1,248</strong></section>",
      "css": ".ds-measurement{padding:20px 0;border-block:1px solid var(--border);background:transparent;color:var(--foreground);font-family:\"Public Sans Variable\",sans-serif;font-size:14px;}.ds-measurement-title{margin:0;font-size:15px;font-weight:650;line-height:1.5;letter-spacing:-.01em;}.ds-measurement-description{margin:3px 0 16px;color:var(--muted-foreground);font-size:12px;line-height:1.6;}.ds-measurement-label{display:block;font-size:12px;font-weight:550;color:var(--muted-foreground);}.ds-measurement-value{display:block;margin:8px 0 6px;font-size:32px;line-height:1.2;font-weight:620;letter-spacing:-.025em;font-variant-numeric:tabular-nums;}"
    },
    {
      "name": "Breakdown row",
      "kind": "custom",
      "refersTo": "breakdown-row",
      "description": "Proportional accent field with right-aligned values.",
      "html": "<a class=\"ds-breakdown\" href=\"#events\"><span class=\"ds-breakdown-fill\"></span><span class=\"ds-breakdown-label\">page_view</span><span class=\"ds-breakdown-values\">824 <span class=\"ds-breakdown-share\">66%</span></span></a>",
      "css": ".ds-breakdown{position:relative;display:flex;align-items:center;justify-content:space-between;height:36px;padding:0 10px;overflow:hidden;border-radius:3px;color:var(--foreground);text-decoration:none;font:13px \"Public Sans Variable\",sans-serif;}.ds-breakdown-fill{position:absolute;inset:0 auto 0 0;width:66%;border-radius:4px;background:var(--accent);}.ds-breakdown-label{position:relative;font-weight:500;}.ds-breakdown-values{position:relative;display:flex;gap:12px;font-variant-numeric:tabular-nums;}.ds-breakdown-share{color:var(--muted-foreground);}.ds-breakdown:hover{background:var(--accent);}.ds-breakdown:focus-visible{outline:2px solid var(--primary);outline-offset:3px;box-shadow:none;}"
    },
    {
      "name": "Line tabs",
      "kind": "nav",
      "refersTo": "tabs-line",
      "description": "Transparent local navigation with an ink active underline.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"Breakdown\"><button class=\"ds-tab\" role=\"tab\" aria-selected=\"true\">Sources</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">Events</button></div>",
      "css": ".ds-tabs{display:inline-flex;gap:4px;height:36px;padding:3px 3px 3px 0;background:transparent;}.ds-tab{position:relative;padding:4px 8px;border:1px solid transparent;border-radius:7px;background:transparent;color:var(--muted-foreground);font:500 12px \"Public Sans Variable\",sans-serif;cursor:pointer;}.ds-tab[aria-selected=true],.ds-tab:hover{color:var(--foreground);}.ds-tab[aria-selected=true]::after{content:\"\";position:absolute;inset:auto 0 -5px;height:2px;background:var(--foreground);}.ds-tab:focus-visible{outline:2px solid var(--primary);outline-offset:3px;box-shadow:none;}"
    }
