  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Squared action with a shallow lower edge, tactile press state, and explicit keyboard focus.",
      "html": "<button class=\"ds-button-primary\">Save changes</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:8px 16px;border-radius:3px;font-weight:600;letter-spacing:-.01em;cursor:pointer;transition:background-color 160ms,border-color 160ms,box-shadow 120ms,transform 120ms;font-family:\"Geist Variable\",sans-serif;font-size:14px;background:var(--primary);color:var(--primary-foreground);border:0;} .ds-button-primary:hover{background:color-mix(in oklab,var(--primary) 90%,transparent);} .ds-button-primary:focus-visible{outline:2px solid var(--primary);outline-offset:3px;} .ds-button-primary:disabled{pointer-events:none;opacity:.5;} @media(max-width:640px){.ds-button-primary{min-height:40px;}} @media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;}} .ds-button-primary{border:1px solid var(--primary);box-shadow:inset 0 1px 0 color-mix(in oklab,var(--primary-foreground) 18%,transparent),0 2px 0 var(--control-edge);}.ds-button-primary:not(:disabled):active{box-shadow:inset 0 1px 2px var(--control-edge),0 1px 0 var(--control-edge);}.ds-button-primary:disabled{box-shadow:none;}@media(prefers-reduced-motion:no-preference){.ds-button-primary:not(:disabled):active{transform:translateY(1px);}}"
    },
    {
      "name": "Outline button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Squared action with a shallow lower edge, tactile press state, and explicit keyboard focus.",
      "html": "<button class=\"ds-button-outline\">Add filter</button>",
      "css": ".ds-button-outline{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:8px 16px;border-radius:3px;font-weight:600;letter-spacing:-.01em;cursor:pointer;transition:background-color 160ms,border-color 160ms,box-shadow 120ms,transform 120ms;font-family:\"Geist Variable\",sans-serif;font-size:14px;background:var(--card);color:var(--foreground);border:1px solid var(--input);} .ds-button-outline:hover{background:var(--muted);border-color:var(--foreground);} .ds-button-outline:focus-visible{outline:2px solid var(--primary);outline-offset:3px;} .ds-button-outline:disabled{pointer-events:none;opacity:.5;} @media(max-width:640px){.ds-button-outline{min-height:40px;}} @media(prefers-reduced-motion:reduce){.ds-button-outline{transition:none;}} .ds-button-outline{border:1px solid var(--input);box-shadow:inset 0 1px 0 var(--control-highlight),0 2px 0 var(--control-edge);}.ds-button-outline:not(:disabled):active{box-shadow:inset 0 1px 2px var(--control-edge),0 1px 0 var(--control-edge);}.ds-button-outline:disabled{box-shadow:none;}@media(prefers-reduced-motion:no-preference){.ds-button-outline:not(:disabled):active{transform:translateY(1px);}}"
    },
    {
      "name": "Ghost button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Compact ghost action with explicit keyboard focus.",
      "html": "<button class=\"ds-button-ghost\">Inspect event</button>",
      "css": ".ds-button-ghost{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:8px 16px;border-radius:4px;font-weight:600;letter-spacing:-.01em;cursor:pointer;transition:all 160ms;font-family:\"Geist Variable\",sans-serif;font-size:14px;background:transparent;color:var(--foreground);border:0;} .ds-button-ghost:hover{background:var(--accent);} .ds-button-ghost:focus-visible{outline:2px solid var(--primary);outline-offset:3px;box-shadow:none;} .ds-button-ghost:disabled{pointer-events:none;opacity:.5;} @media(max-width:640px){.ds-button-ghost{min-height:40px;}} @media(prefers-reduced-motion:reduce){.ds-button-ghost{transition:none;}}"
    },
    {
      "name": "Text field",
      "kind": "input",
      "refersTo": "input",
      "description": "Visible label with a clear field boundary.",
      "html": "<label class=\"ds-field-label\" for=\"ds-name\">Product name</label><input class=\"ds-input\" id=\"ds-name\" placeholder=\"Product name\" value=\"Piko website\">",
      "css": ".ds-field-label{display:block;margin-bottom:6px;color:var(--foreground);font:500 12px \"Geist Variable\",sans-serif;}.ds-input{width:100%;height:36px;padding:4px 12px;background:var(--card);color:var(--foreground);border:1px solid var(--input);border-radius:3px;font-family:\"Geist Variable\",sans-serif;font-size:14px;}.ds-input::placeholder{color:var(--muted-foreground);}.ds-input:focus-visible{outline:2px solid var(--primary);outline-offset:3px;box-shadow:none;}.ds-input[aria-invalid=true]{border-color:var(--destructive);}.ds-input:disabled{opacity:.5;pointer-events:none;}@media(max-width:767px){.ds-input{font-size:16px;}}@media(max-width:640px){.ds-input{min-height:40px;}} .ds-input{box-shadow:inset 0 1px 2px color-mix(in oklab,var(--border) 60%,transparent);}"
    },
    {
      "name": "Workspace navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Muted yellow or charcoal rail with a shallow raised active navigation item.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><a class=\"ds-nav-item\" href=\"#overview\">Overview</a><a class=\"ds-nav-item\" href=\"#explore\" aria-current=\"page\">Explore</a><a class=\"ds-nav-item\" href=\"#settings\">Settings</a></nav>",
      "css": ".ds-nav{width:240px;padding:8px;background:var(--sidebar);font-family:\"Geist Variable\",sans-serif;font-size:14px;}.ds-nav-item{display:flex;align-items:center;height:36px;padding:8px;border-radius:3px;color:var(--sidebar-foreground);text-decoration:none;}.ds-nav-item[aria-current=page]{background:var(--primary);color:var(--primary-foreground);font-weight:650;}.ds-nav-item:hover,.ds-nav-item:active{background:var(--sidebar-accent);color:var(--sidebar-accent-foreground);}.ds-nav-item:focus-visible{outline:2px solid var(--primary);outline-offset:3px;box-shadow:none;} .ds-nav-item[aria-current=page]:hover{background:var(--primary);color:var(--primary-foreground);} .ds-nav-item{border:1px solid transparent;}.ds-nav-item[aria-current=page]{border-color:var(--primary);box-shadow:inset 0 1px 0 color-mix(in oklab,var(--primary-foreground) 18%,transparent),0 2px 0 var(--control-edge);}"
    },
    {
      "name": "Source badge",
      "kind": "chip",
      "refersTo": "badge-outline",
      "description": "Quiet metadata annotation; a non-interactive label.",
      "html": "<span class=\"ds-badge\">Website</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;padding:2px 8px;border:1px solid var(--border);border-radius:3px;color:var(--foreground);background:transparent;font:500 12px/1.5 \"Geist Variable\",sans-serif;white-space:nowrap;}"
    },
    {
      "name": "Contained card",
      "kind": "card",
      "refersTo": "card-contained",
      "description": "A bounded editing region; no resting shadow.",
      "html": "<section class=\"ds-card\"><h2 class=\"ds-card-title\">Product details</h2><p class=\"ds-card-description\">Give this product a name and set its defaults.</p><div class=\"ds-card-content\">Product settings</div></section>",
      "css": ".ds-card{padding:20px 24px;border:1px solid var(--border);border-radius:6px;border-top:2px solid var(--input);background:var(--card);color:var(--foreground);box-shadow:none;font-family:\"Geist Variable\",sans-serif;font-size:14px;}.ds-card-title{margin:0;font-size:15px;font-weight:650;line-height:1.5;letter-spacing:-.01em;}.ds-card-description{margin:3px 0 0;color:var(--muted-foreground);font-size:12px;line-height:1.6;}.ds-card-content{margin-top:16px;}"
    },
    {
      "name": "Measurement field",
      "kind": "custom",
      "refersTo": "measurement-field",
      "description": "Open analytical section bounded by fine horizontal seams.",
      "html": "<section class=\"ds-measurement\"><h2 class=\"ds-measurement-title\">Events over time</h2><p class=\"ds-measurement-description\">Events in the selected range.</p><span class=\"ds-measurement-label\">Events</span><strong class=\"ds-measurement-value\">1,248</strong></section>",
      "css": ".ds-measurement{padding:20px 0;border-block:1px solid var(--border);background:transparent;color:var(--foreground);font-family:\"Geist Variable\",sans-serif;font-size:14px;}.ds-measurement-title{margin:0;font-size:15px;font-weight:650;line-height:1.5;letter-spacing:-.01em;}.ds-measurement-description{margin:3px 0 16px;color:var(--muted-foreground);font-size:12px;line-height:1.6;}.ds-measurement-label{display:block;font-size:12px;font-weight:550;color:var(--muted-foreground);}.ds-measurement-value{display:block;margin:8px 0 6px;font-size:32px;line-height:1.2;font-weight:650;letter-spacing:-.035em;font-variant-numeric:tabular-nums;}"
    },
    {
      "name": "Breakdown row",
      "kind": "custom",
      "refersTo": "breakdown-row",
      "description": "Proportional accent field with right-aligned values.",
      "html": "<a class=\"ds-breakdown\" href=\"#events\"><span class=\"ds-breakdown-fill\"></span><span class=\"ds-breakdown-label\">page_view</span><span class=\"ds-breakdown-values\">824 <span class=\"ds-breakdown-share\">66%</span></span></a>",
      "css": ".ds-breakdown{position:relative;display:flex;align-items:center;justify-content:space-between;height:36px;padding:0 10px;overflow:hidden;border-radius:0;color:var(--foreground);text-decoration:none;font:13px \"Geist Variable\",sans-serif;}.ds-breakdown-fill{position:absolute;inset:0 auto 0 0;width:66%;border-radius:0;background:var(--accent);}.ds-breakdown-label{position:relative;font-weight:500;}.ds-breakdown-values{position:relative;display:flex;gap:12px;font-variant-numeric:tabular-nums;}.ds-breakdown-share{color:var(--muted-foreground);}.ds-breakdown:hover{background:var(--accent);}.ds-breakdown:focus-visible{outline:2px solid var(--primary);outline-offset:3px;box-shadow:none;}"
    },
    {
      "name": "Framed tabs",
      "kind": "nav",
      "refersTo": "tabs-line",
      "description": "Shared bottom rule with a framed selected face and flat inactive labels.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"Breakdown\"><button class=\"ds-tab\" role=\"tab\" aria-selected=\"true\">Sources</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">Events</button></div>",
      "css": ".ds-tabs{display:inline-flex;gap:0;height:36px;padding:0;background:transparent;border-bottom:1px solid var(--input);}.ds-tab{position:relative;height:100%;margin-bottom:-1px;padding:4px 8px;border:1px solid transparent;border-radius:3px 3px 0 0;background:transparent;color:var(--muted-foreground);font:500 12px \"Geist Variable\",sans-serif;cursor:pointer;}.ds-tab[aria-selected=true]{background:var(--card);color:var(--foreground);border-color:var(--input);border-bottom-color:var(--card);box-shadow:inset 0 1px 0 var(--control-highlight);}.ds-tab:hover{color:var(--foreground);}.ds-tab:focus-visible{outline:2px solid var(--primary);outline-offset:3px;}"
    }
  ],
  "narrative": {
    "northStar": "Yuzu",
    "overview": "Piko is a compact measurement tool with a graphic identity. Muted yellow navigation in Light, charcoal surfaces in Dark, and ochre plots give the workspace its user-selected Yuzu character. Self-hosted Geist, shallow raised controls, framed tabs, solid ink selections, and the straight three-bar mark make the identity visible beyond its palette.\n\nAnalytical regions share a continuous ground with fine seams, aligned labels, and tabular values. Editing and inspection use contained surfaces where boundaries clarify the task. Density serves reading: supporting context remains visible, and loading states preserve the geometry of the result they will replace. Light, Dark, and Auto belong to the same visual world.",
    "keyCharacteristics": [
      "Soft stone in Light, deep charcoal in Dark, ink actions, and restrained Yuzu measurements.",
      "Geist typography with restrained headings and prominent measurements.",
      "Flat analytical fields; contained forms and inspection.",
      "Tactile squared controls, explicit focus, and stable loading geometry."
    ],
    "rules": [
      {
        "name": "The Measured Color Rule",
        "body": "Use ink primary for actions and navigation selection, data ochre for plotted measurements, and semantic success/destructive colors for status; keep surrounding evidence neutral.",
        "section": "colors"
      },
      {
        "name": "The Value Alignment Rule",
        "body": "Use tabular numerals for measurements, percentages, durations, and times that readers compare across rows.",
        "section": "typography"
      },
      {
        "name": "The Shared Ground Rule",
        "body": "Keep analytical regions flat and aligned; reserve enclosed containers for editing, inspection, and genuinely separate context.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse semantic theme variables so Light, Dark, and Auto retain the same hierarchy.",
      "Do preserve the shared upright three-bar logo/favicon, Geist, and the Yuzu ink/yellow/ochre relationship.",
      "Do align measurements and use fine dividers to connect analytical regions.",
      "Do keep visible labels, focus outlines, readable metadata, and touch-sized controls on narrow screens.",
      "Do preserve chart and table geometry while data loads or refreshes.",
      "Do use the existing line chart, actual event identity kinds, and truthful empty or error states.",
      "Do use official Bklit UI charts with semantic colors, UTC labels, missing-value gaps, keyboard inspection, touch scrolling, and stable refresh geometry.",
      "Do use official Skullet for component loading, keep report controls within the heading layout, and keep connection state and version/license details out of product chrome."
    ],
    "donts": [
      "Don't return to a corporate blue card grid or a black neon terminal identity.",
      "Don't wrap every measurement in a raised, rounded card.",
      "Don't add decorative botanical imagery, faux paper textures, or ornamental glow.",
      "Don't replace useful event context with decoration or hide an actual loading failure behind a skeleton.",
      "Don't turn the Explore composition into a mandatory layout for every page."
    ]
  }
}
