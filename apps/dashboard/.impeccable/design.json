      "css": ".ds-select{display:inline-flex;align-items:center;justify-content:space-between;gap:8px;height:36px;padding:8px 12px;border:1px solid var(--input);border-radius:var(--radius-md);background:var(--surface-inset);color:var(--foreground);font:400 14px/20px \"Geist Variable\",sans-serif;cursor:pointer;transition:background-color 160ms ease-out,color 160ms ease-out,border-color 160ms ease-out;}.ds-select svg{flex-shrink:0;color:var(--muted-foreground);}.ds-select:hover{border-color:var(--muted-foreground);}.ds-select[aria-expanded=true]{background:var(--surface-hover);border-color:var(--ring);}.ds-select:focus-visible{outline:2px solid var(--ring);outline-offset:3px;}@media(max-width:640px){.ds-select{min-height:40px;}}@media(prefers-reduced-motion:reduce){.ds-select{transition:none;}}"
