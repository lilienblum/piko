      "html": "<label class=\"ds-field-label\" for=\"ds-name\">Product name</label><input class=\"ds-input\" id=\"ds-name\" placeholder=\"Product name\" value=\"Piko website\">",
      "css": ".ds-field-label{display:block;margin-bottom:6px;color:var(--foreground);font:500 12px \"Public Sans Variable\",sans-serif;}.ds-input{width:100%;height:36px;padding:4px 12px;background:var(--card);color:var(--foreground);border:1px solid var(--input);border-radius:7px;font-family:\"Public Sans Variable\",sans-serif;font-size:14px;}.ds-input::placeholder{color:var(--muted-foreground);}.ds-input:focus-visible{outline:2px solid var(--primary);outline-offset:3px;box-shadow:none;}.ds-input[aria-invalid=true]{border-color:var(--destructive);}.ds-input:disabled{opacity:.5;pointer-events:none;}@media(max-width:767px){.ds-input{font-size:16px;}}@media(max-width:640px){.ds-input{min-height:40px;}}"
    },
    {
      "name": "Workspace navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Citron rail with flat active navigation.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><a class=\"ds-nav-item\" href=\"#overview\">Overview</a><a class=\"ds-nav-item\" href=\"#explore\" aria-current=\"page\">Explore</a><a class=\"ds-nav-item\" href=\"#settings\">Settings</a></nav>",
      "css": ".ds-nav{width:208px;padding:8px;background:var(--sidebar);font-family:\"Public Sans Variable\",sans-serif;font-size:14px;}.ds-nav-item{display:flex;align-items:center;height:48px;padding:8px;border-radius:7px;color:var(--sidebar-foreground);text-decoration:none;}.ds-nav-item[aria-current=page]{background:var(--sidebar-accent);color:var(--sidebar-accent-foreground);font-weight:650;}.ds-nav-item:hover,.ds-nav-item:active{background:var(--sidebar-accent);color:var(--sidebar-accent-foreground);}.ds-nav-item:focus-visible{outline:2px solid var(--primary);outline-offset:3px;box-shadow:none;}"
