      "description": "A bounded editing region; no resting shadow.",
      "html": "<section class=\"ds-card\"><h2 class=\"ds-card-title\">Product details</h2><p class=\"ds-card-description\">Give this product a name and set its defaults.</p><div class=\"ds-card-content\">Product settings</div></section>",
      "css": ".ds-card{padding:20px 24px;border:1px solid var(--border);border-radius:var(--radius-xl);background:var(--card);color:var(--card-foreground);box-shadow:none;font-family:\"Geist Variable\",sans-serif;font-size:14px;}.ds-card-title{margin:0;font-size:15px;font-weight:650;line-height:1.5;letter-spacing:-.01em;}.ds-card-description{margin:3px 0 0;color:var(--muted-foreground);font-size:12px;line-height:1.6;}.ds-card-content{margin-top:16px;}"
