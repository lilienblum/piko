      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Compact primary action with explicit keyboard focus.",
      "html": "<button class=\"ds-button-primary\">Save changes</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:8px 16px;border-radius:7px;font-weight:500;cursor:pointer;transition:all 160ms;font-family:\"Public Sans Variable\",sans-serif;font-size:14px;background:var(--primary);color:var(--primary-foreground);border:0;} .ds-button-primary:hover{background:color-mix(in oklab,var(--primary) 90%,transparent);} .ds-button-primary:focus-visible{outline:2px solid var(--primary);outline-offset:3px;box-shadow:none;} .ds-button-primary:disabled{pointer-events:none;opacity:.5;} @media(max-width:640px){.ds-button-primary{min-height:40px;}} @media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;}}"
    },
