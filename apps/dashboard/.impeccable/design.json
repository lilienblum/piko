      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:8px 16px;border:0;border-radius:var(--radius-md);font:550 14px/20px \"Geist Variable\",sans-serif;cursor:pointer;background:var(--primary);color:var(--primary-foreground);box-shadow:var(--elevation-control);transition:background-color 160ms ease-out,color 160ms ease-out,border-color 160ms ease-out;}.ds-button-primary:hover{background:var(--primary-hover);}.ds-button-primary:active{background:var(--primary-active);}.ds-button-primary:focus-visible{outline:2px solid var(--ring);outline-offset:3px;}.ds-button-primary:disabled{opacity:.5;pointer-events:none;}@media(max-width:640px){.ds-button-primary{min-height:40px;}}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;}}"
