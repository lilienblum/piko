{
  "name": "piko",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1",
    "build": "bun typecheck && bun --bun vite build && bun build sdk/typescript/browser.ts --target browser --format esm --outfile dist/tracker.js",
    "fmt": "biome format --write . && cargo fmt --all",
    "fmt:check": "biome format . && cargo fmt --all --check",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test sdk scripts",
    "test:e2e": "bun --bun playwright test",
    "benchmark": "bun scripts/benchmark.ts",
    "seed": "bun scripts/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.1",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.3.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "vite": "^7.3.0",
    "typescript": "^5.9.3",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "@playwright/test": "^1.58.0"
  }
}
