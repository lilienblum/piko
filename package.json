{
  "name": "piko",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun run --cwd apps/dashboard build && bun typecheck",
    "fmt": "bun node_modules/@biomejs/biome/bin/biome format --write . && cargo fmt --all",
    "fmt:check": "bun node_modules/@biomejs/biome/bin/biome format . && cargo fmt --all --check",
    "lint": "bun node_modules/@biomejs/biome/bin/biome lint .",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test sdk scripts",
    "test:e2e": "bun scripts/e2e.ts",
    "benchmark": "bun scripts/benchmark.ts",
    "seed": "bun scripts/seed.ts",
    "dev:dashboard": "bun run --cwd apps/dashboard dev",
    "dev:stop": "bun scripts/dev.ts --stop",
    "dev:standalone": "bun scripts/dev-standalone.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/bun": "latest",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "workspaces": [
    "apps/dashboard"
  ],
  "license": "MIT",
  "dependencies": {
    "tako.sh": "0.0.0-9ae824f"
  }
}
