{
  "name": "piko",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun --cwd apps/dashboard run build && bun typecheck && bun build sdk/typescript/browser.ts --target browser --format esm --outfile apps/dashboard/dist/client/tracker.js",
    "fmt": "biome format --write . && cargo fmt --all",
    "fmt:check": "biome format . && cargo fmt --all --check",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test sdk scripts",
    "test:e2e": "bun --bun playwright test",
    "benchmark": "bun scripts/benchmark.ts",
    "seed": "bun scripts/seed.ts",
    "dev:dashboard": "bun --cwd apps/dashboard dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "vite": "^7.3.0",
    "typescript": "^5.9.3",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "@playwright/test": "^1.58.0"
  },
  "workspaces": [
    "apps/dashboard"
  ]
}
