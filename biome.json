{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/components/ui",
      "!**/routeTree.gen.ts",
      "!**/tako.d.ts",
      "!**/dist",
      "!target",
      "!bun.lock",
      "!data",
      "!docs/benchmark-results.json",
      "!test-results",
      "!playwright-report"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["apps/dashboard/DESIGN.md"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
